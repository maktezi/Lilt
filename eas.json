{
  "cli": { "version": ">= 19.0.8", "appVersionSource": "remote" },
  "build": {
    "preview": {
      "environment": "preview",
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "ios": { "simulator": false }
    },
    "simulator": { "distribution": "internal", "ios": { "simulator": true } },
    "production": { "environment": "production", "autoIncrement": true }
  }
}
