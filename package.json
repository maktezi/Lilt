{
  "name": "lilt",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.3",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build": "expo export --platform web && node scripts/build-offline.mjs",
    "build:android:preview": "EAS_NO_VCS=1 eas build --platform android --profile preview",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:ui": "playwright test"
  },
  "dependencies": {
    "expo": "58.0.23",
    "expo-audio": "58.0.11",
    "expo-crypto": "58.0.7",
    "expo-document-picker": "58.0.4",
    "expo-file-system": "58.0.13",
    "expo-font": "58.0.11",
    "expo-sharing": "58.0.21",
    "expo-sqlite": "58.0.14",
    "expo-status-bar": "58.0.4",
    "@expo/vector-icons": "15.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "5.11.1",
    "react-native-web": "0.21.4"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@playwright/test": "1.64.1",
    "typescript": "6.0.3"
  }
}
