  "narrative": {
    "northStar": "Your music, kept close",
    "overview": "The November 2026 redesign follows the user's Spotify-style brief, superseding the earlier ivory, serif, and terracotta direction. Lilt retains its own name, logo, local library, offline playback, import tools, and converter integrations. Near-black inset panels, bold sans-serif hierarchy, green actions, rounded filters, and dense song rows make this an operating surface for choosing, organizing, downloading, and playing music.\n\nDark appearance is the default for new installations. Existing appearance preferences remain honored, including Device default and Light. The shared implementation serves React Native on iOS and Android and React Native Web.",
    "keyCharacteristics": [
      "Near-black panels and bright green playback actions.",
      "Bold sans-serif headings and practical, scalable body text.",
      "Flat tonal layering around a persistent player.",
      "Adaptive navigation and deterministic geometric sleeve placeholders.",
      "Truthful empty, downloading, failed, and saved states."
    ],
    "rules": [
      {
        "name": "The Shared Palette Rule",
        "body": "Read colors from the active theme; pair every accent action with onAccent so both appearances remain readable.",
        "section": "colors"
      },
      {
        "name": "The Persistent Playback Rule",
        "body": "Keep playback available while navigating, and minimize the full-screen player without pausing.",
        "section": "components"
      },
      {
        "name": "The Durable Save Rule",
        "body": "Show success only after the storage commit; progress and recovery actions must reflect application state.",
        "section": "components"
      }
    ],
    "dos": [
      "Do use the shared theme and typography roles across native and web.",
      "Do retain safe areas, scalable text, accessible labels, keyboard operation, and minimum 48-unit action targets.",
      "Do preserve collection order and truthful loading, error, unavailable, and saved states.",
      "Do identify deterministic sleeves as placeholders rather than fetched album artwork."
    ],
    "donts": [
      "Don't restore the superseded ivory, serif, and terracotta direction.",
      "Don't fabricate songs, artists, artwork, connected providers, or transfer success.",
      "Don't use browser screenshots as proof of native simulator or hardware acceptance.",
      "Don't promote the first-import welcome composition into a universal screen template."
    ]
  }
